<Window x:Class="BlueMenu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:BlueMenu.App.Models"
        mc:Ignorable="d"
        Title="BlueMenu"
        Width="460"
        Height="700"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/BlueMenu.ico"
        Background="#F6F7FB"
        FontFamily="Segoe UI Variable Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock Text="Bluetooth" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Width="32" Height="32" Margin="8,0,0,0" Command="{Binding ToggleSettingsCommand}" ToolTip="Settings">⚙</Button>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFF5E6" BorderBrush="#F59E0B" BorderThickness="1" Padding="8" CornerRadius="8" Margin="0,0,0,8"
                Visibility="{Binding GlobalError, Converter={StaticResource StringHasContentToVisibilityConverter}}">
            <TextBlock Text="{Binding GlobalError}" Foreground="#7C2D12" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Paired Devices" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding PairedDevices}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BluetoothDeviceItem}">
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="10" Height="10" Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding State}" Foreground="#6B7280" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Failed to Pair" Foreground="#B91C1C" FontSize="12"/>
                                        <Button Content="ⓘ" Margin="4,0,0,0" Padding="4,0" Command="{Binding DataContext.ShowErrorInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <CheckBox Content="Auto-connect" IsChecked="{Binding IsAutoConnectEnabled}" Margin="0,4,0,0" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Connect" Margin="0,0,4,0" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Content="Disconnect" Margin="0,0,4,0" Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Content="Forget" Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="Nearby Devices" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ListBox Grid.Row="3" ItemsSource="{Binding NearbyDevices}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BluetoothDeviceItem}">
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding State}" Foreground="#6B7280" FontSize="12"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Pair" Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Expander Grid.Row="4" Header="Settings" IsExpanded="{Binding SettingsVisible}" Margin="0,8,0,8">
                <StackPanel Margin="8">
                    <CheckBox Content="Remember window position" IsChecked="{Binding RememberWindowPosition}" Margin="0,0,0,6"/>
                    <CheckBox Content="Show connect/disconnect notifications" IsChecked="{Binding ShowNotifications}" Margin="0,0,0,6"/>
                    <CheckBox Content="Open at startup" IsChecked="{Binding OpenAtStartup}" Margin="0,0,0,6"/>
                    <CheckBox Content="Show debug log panel" IsChecked="{Binding ShowDebugLog}" />
                </StackPanel>
            </Expander>

            <Border Grid.Row="5" Background="#111827" CornerRadius="8" Padding="8" Visibility="{Binding ShowDebugLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Copy debug/log info" HorizontalAlignment="Right" Margin="0,0,0,6" Command="{Binding CopyLogsCommand}"/>
                    <ListBox ItemsSource="{Binding Logs}" BorderThickness="0" Background="#111827">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <TextBlock Text="{Binding Display}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Foreground="#B45309" Margin="0,8,0,0"
                   Text="Running without elevation — some features may not work"
                   Visibility="{Binding IsRunningElevated, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</Window>
